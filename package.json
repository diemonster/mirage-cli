{
  "name": "mirage-cli",
  "version": "0.1.0",
  "description": "CLI for sending samples to an Ensoniq Mirage DMS-8 (MASOS) over MIDI SysEx",
  "type": "module",
  "bin": {
    "mirage-send": "./bin/mirage-send"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "jzz": "^1.8.10"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
